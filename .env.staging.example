# =====================================================================================================
# SAP BRIM AI (Clyptus.AI) - STAGING settings template for docker-compose.prod.yml
# =====================================================================================================
# Staging runs the production images and production security settings, plus:
#   - its own Compose project and volumes (COMPOSE_PROJECT_NAME), so it never shares data with production;
#   - an HTTP basic-auth gate in front of the app and every public API endpoint (ACCESS_MODE=basic_auth);
#   - individual sign-up closed (REGISTRATION_ENABLED=False); tester accounts are created by an admin
#     (scripts/staging/create-user.sh);
#   - the web container bound to 127.0.0.1 until the security checks have passed (WEB_BIND).
# Runbook: docs/STAGING_DEPLOYMENT.md. On the server, in the repository root:
#     cp .env.staging.example .env && chmod 600 .env
#     scripts/staging/init-env.sh        # fills every secret with fresh random values (prints none)
# then set APP_DOMAIN / ALLOWED_ORIGINS, SUPER_ADMIN_EMAIL and at least one LLM key. Never commit .env.
# =====================================================================================================

COMPOSE_FILE=docker-compose.prod.yml
APP_ENV_FILE=.env
COMPOSE_PROJECT_NAME=sap_brim_staging
# Proxy trust: the backend believes X-Forwarded-* only from WEB_IP. Staging gets its own subnet so it can
# run on the same host as production (Docker rejects overlapping subnets).
PROXY_SUBNET=172.29.251.0/24
WEB_IP=172.29.251.10
# Set by scripts/staging/deploy.sh to the deployed git commit (rollback starts the previous tag).
IMAGE_TAG=staging

# ===== Public address =====
# Host name without https://. Without your own domain use the free wildcard DNS name of the server IP,
# e.g. 203-0-113-10.sslip.io for 203.0.113.10 (Let's Encrypt issues a real certificate for it).
# While WEB_BIND=127.0.0.1 use APP_DOMAIN=localhost (Caddy's internal certificate) for private testing.
APP_DOMAIN=staging.example.com
# The same host name with https:// (never localhost: production mode refuses it).
ALLOWED_ORIGINS=https://staging.example.com
ENVIRONMENT=production
HTTP_PORT=80
HTTPS_PORT=443
# 127.0.0.1 = private (only from the server, e.g. through an SSH tunnel); 0.0.0.0 = public.
WEB_BIND=127.0.0.1
APP_UID=1000

# ===== Staging gate (HTTP basic auth in front of the app and the public API endpoints) =====
ACCESS_MODE=basic_auth
STAGING_BASIC_AUTH_USER=staging
# bcrypt hash from: docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains "$" characters.
STAGING_BASIC_AUTH_HASH=''

# ===== PostgreSQL (staging volume sap_brim_staging_pgdata; not published) =====
POSTGRES_USER=sap_assistant
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=sap_assistant
SAP_BRIM_DB_PASSWORD=change-me-app-password
DATABASE_URL=postgresql://sap_brim_ai:change-me-app-password@postgres:5432/sap_brim_ai
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== Security =====
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_API_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Closed: testers get accounts from an admin, not through public sign-up.
REGISTRATION_ENABLED=False
DEFAULT_ACCESS_GROUP=all
RATE_LIMIT_ENABLED=True
REDIS_URL=
REDIS_PASSWORD=
REDIS_CPUS=0.25
REDIS_MEMORY=256m

# ===== LLM providers (use separate staging keys with spending limits) =====
LLM_PROVIDER=groq
LLM_ALLOWED_PROVIDERS=groq,gemini,openrouter
LLM_ALLOW_FREE_TIER=False
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_TOKENS_PER_MINUTE=8000
LLM_LAST_RESORT_MODELS=allam-2-7b,liquid/lfm-2.5-2.6b:free
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Extra API keys per provider for the worst case. A key is used only when the key before it (the normal key
# above, then FALLBACK_1, 2, 3) is rejected, out of credit or out of quota; only when every key of a provider
# fails does the request move on to the next provider. Leave a name empty to leave that slot unused. After
# filling one in, restart the backend (docker compose up -d backend) and it is used automatically.
# Use a separate key (ideally from a separate account or project) for each slot. Never commit real keys.
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_API_KEY_FALLBACK_3=
GEMINI_API_KEY_FALLBACK_1=
GEMINI_API_KEY_FALLBACK_2=
GEMINI_API_KEY_FALLBACK_3=
OPENROUTER_API_KEY_FALLBACK_1=
OPENROUTER_API_KEY_FALLBACK_2=
OPENROUTER_API_KEY_FALLBACK_3=
LLM_REQUEST_DEADLINE_SECONDS=120
MAX_MESSAGE_CHARS=12000

# ===== RAG & Embeddings (must match the knowledge-base seed loaded into staging) =====
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
RETRIEVAL_CACHE_WARMUP=True
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65
DOCUMENT_MATCH_THRESHOLD=0.80
AUTO_MULTI_SOURCE_FALLBACK=True
ANSWER_TEMPERATURE=0.10
INCLUDE_SELF_AUTHORED_DOCS=False

# ===== Web search (optional) =====
WEB_FALLBACK_ENABLED=True
WEB_SEARCH_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_MAX_IMAGES=4
REPO_SOURCE_ENABLED=false
MULTI_SOURCE_COMPARE_ENABLED=false
SAP_WEB_SOURCES_ENABLED=false

# ===== Organisation Portal =====
ORG_ACTIVATION_CODE_TTL_HOURS=72
ORG_ACTIVATION_RATE_LIMIT_PER_MINUTE=10
ORG_REQUEST_RATE_LIMIT_PER_HOUR=5
ORG_MEMBER_CREATE_RATE_LIMIT_PER_HOUR=30

# ===== Container limits (sized for a 4-8 GB server) =====
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1g
BACKEND_CPUS=2.0
BACKEND_MEMORY=3g
WEB_CPUS=0.5
WEB_MEMORY=256m

VITE_API_BASE_URL=

# Capacity: how many users can be served at once without one burst taking the service down.
# At most MAX_CONCURRENT_ANSWERS answers run at the same time; up to ANSWER_QUEUE_MAX more wait at most
# ANSWER_QUEUE_WAIT_SECONDS for a slot and the rest get an immediate "busy, try again" (503). One user may
# run MAX_CONCURRENT_ANSWERS_PER_USER at a time (429 beyond that). Each running answer may use a database
# connection: keep MAX_CONCURRENT_ANSWERS + 6 <= DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW (30 by default).
MAX_CONCURRENT_ANSWERS=16
ANSWER_QUEUE_MAX=32
ANSWER_QUEUE_WAIT_SECONDS=15
MAX_CONCURRENT_ANSWERS_PER_USER=3
THREADPOOL_SIZE=64
DATABASE_POOL_TIMEOUT=10
SHUTDOWN_DRAIN_SECONDS=25
WEB_SEARCH_TIMEOUT_SECONDS=15
