.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp_*/
.env
.env.*
/.admin-initial-password
!.env.example
# Local deployment state written by scripts/staging/*.sh (previous image tag, backups)
.deploy/
!scripts/staging/
node_modules/
dist/
build/
frontend/test-results/
frontend/playwright-report/

# Database files (>100MB, generated via ingest script)
*.db
*.db.bak
backend/sap_assistant.db

# Knowledge base documents
# The 61 PDFs already tracked stay tracked until the owner approves moving them to private storage
# (SECURITY_DEPLOYMENT_CHECKLIST.md, "Knowledge-base documents"). New PDFs are NOT committed by accident;
# use `git add -f` only for documents you are licensed to redistribute.
knowledge_base/documents/*.pdf

# Cloned GitHub repository snapshots (>500MB)
backend/data/github_snapshots/

# Scratch & test outputs
scratch/
scratch_validation_output.json

# SQLite cutover backups and migration logs (keep until deletion is authorized)
backups/

# Database dumps and logs (may contain application data)
*.dump
*.sql.gz
*.sql
*.bak
*.old
*.log
# Private keys and certificates must never be committed
*.pem
*.key
*.p12
# Local secret scanner output (can reference sensitive files even when values are redacted)
gitleaks*.json
semgrep*.json
bandit*.json

# Tool caches and coverage output
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.tsbuildinfo

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
